project_id                = "your-project-id"
region                    = "us-central1"
zone                      = "us-central1-a"
terraform_service_account = "your-service-account@your-project.iam.gserviceaccount.com"
network_project_id        = "your-host-network-project-id"
subnet_name               = "your-subnet-name"
create_linux_vm           = true
create_windows_vm         = false
instance_name             = "minimal-linux-vm"
machine_type              = "e2-micro"
windows_instance_name     = "minimal-windows-vm"
windows_machine_type      = "e2-medium"
